# Maintainer: FastTransfer Contributors
# Arch Linux PKGBUILD for FastTransfer
pkgname=fasttransfer
pkgver=1.0.0
pkgrel=1
pkgdesc="High-speed direct PC-to-PC file transfer application over Ethernet"
arch=('x86_64')
url="https://github.com/fasttransfer/fasttransfer"
license=('MIT')
depends=(
    'qt6-base'
)
makedepends=(
    'cmake'
    'ninja'
    'gcc'
)
optdepends=(
    'ethtool: for detailed hardware link speed diagnostics'
)
source=("$pkgname-$pkgver::git+file://$PWD")
sha256sums=('SKIP')

build() {
    cmake -B build -S "$srcdir/../.." \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -GNinja
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$srcdir/../../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
